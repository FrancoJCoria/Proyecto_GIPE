    {
      "name": "04 - Seguridad (401 y 403)",
      "item": [
        {
          "name": "Login Empleado (segundo JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var body = pm.response.json();",
                  "pm.test('El rol del usuario es Empleado', function () {",
                  "    pm.expect(body.usuario.rol).to.eql(2);",
                  "});",
                  "",
                  "pm.collectionVariables.set('token_empleado', body.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"empleado@gipe.com\",\n  \"password\": \"Empleado123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "El test guarda el JWT en `token_empleado` (RolUsuario.Empleado = 2)."
          },
          "response": []
        },
        {
          "name": "Crear producto con token Empleado (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recurso restringido al Dueno pero con token de Empleado: 403', function () {",
