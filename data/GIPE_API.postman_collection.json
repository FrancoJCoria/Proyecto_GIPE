                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_empleado}}", "type": "string" } ] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Denegado\",\n  \"costoExtra\": 0,\n  \"margenObjetivo\": 10,\n  \"precioActual\": 100,\n  \"stockActual\": 1\n}"
            },
            "url": {
