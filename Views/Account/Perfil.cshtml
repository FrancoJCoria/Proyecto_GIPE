@model UsuarioRespuestaDto
@{
    ViewData["Title"] = "Mi perfil";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Mi perfil</h1>
    @if (User.IsInRole("Dueno"))
    {
        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-primary">
            Administrar usuarios
        </a>
    }
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Rol</dt>
            <dd class="col-sm-9">@(Model.Rol == RolUsuario.Dueno ? "Dueño" : "Empleado")
                
            </dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Estado ? "bg-success" : "bg-secondary")"> @(Model.Estado ? "Activo" : "Inactivo")</span>
            </dd>

            @if (!string.IsNullOrWhiteSpace(Model.Url_avatar))
            {
                <dt class="col-sm-3">Avatar</dt>
                <dd class="col-sm-9">
                    <a href="@Model.Url_avatar" target="_blank" rel="noopener noreferrer">@Model.Url_avatar</a>
                </dd>
            }
        </dl>
    </div>
</div>

<form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
    <button type="submit" class="btn btn-outline-danger">Cerrar sesión</button>
</form>
