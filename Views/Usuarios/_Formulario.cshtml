@model UsuarioFormViewModel

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" autocomplete="email" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Password" class="form-label"></label>
    <input asp-for="Password" class="form-control" autocomplete="new-password" />
    <div class="form-text">
        @(Model.Id == 0
            ? "Mínimo 8 caracteres."
            : "Dejá vacía este campo para mantener la contraseña actual.")
    </div>
    <span asp-validation-for="Password" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Rol" class="form-label"></label>
    <select asp-for="Rol" class="form-select">
        <option value="@((int)RolUsuario.Dueno)">Dueño</option>
        <option value="@((int)RolUsuario.Empleado)">Empleado</option>
    </select>
    <span asp-validation-for="Rol" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Url_avatar" class="form-label"></label>
    <input asp-for="Url_avatar" class="form-control" placeholder="https://..." />
    <span asp-validation-for="Url_avatar" class="text-danger"></span>
</div>

<div class="mb-3">
    <label for="archivoAvatar" class="form-label">Foto de perfil</label>
    @if (!string.IsNullOrWhiteSpace(Model.Url_avatar))
    {
        <div class="mb-2">
            <img src="@Model.Url_avatar" alt="Avatar de @Model.Nombre"
                 class="rounded-circle border" style="width: 64px; height: 64px; object-fit: cover;" />
        </div>
    }
    <input type="file" id="archivoAvatar" name="archivoAvatar" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
    <div class="form-text">
        JPG, PNG o WEBP, maximo 5 MB. Si subis una foto, reemplaza a la URL de arriba.
        Igual que inmobiliariaULP: la imagen se guarda en wwwroot/Uploads/Avatares.
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="Estado" class="form-check-input" />
    <label asp-for="Estado" class="form-check-label"></label>
    <span asp-validation-for="Estado" class="text-danger d-block"></span>
</div>
