@model ResultadoPaginado<VentaListaItem>
@{
    ViewData["Title"] = "Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Ventas</h1>
    <a asp-action="Crear" class="btn btn-primary">+ Nueva venta</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Venta</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Registrada por</th>
                    <th class="text-end">Monto total</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.HayFilas)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Todavia no hay ventas registradas.</td>
                    </tr>
                }
                @foreach (var venta in Model.Filas)
                {
                    <tr>
                        <td>#@venta.Id <span class="badge text-bg-success ms-1">Vigente</span></td>
                        <td>@Formateos.FechaHora(venta.Fecha)</td>
                        <td>@(venta.ClienteNombre ?? "Venta mostrador")</td>
                        <td>@venta.UsuarioNombre</td>
                        <td class="text-end fw-bold">@Formateos.Dinero(venta.MontoTotal)</td>
                        <td class="text-end">
                            <a asp-action="Detalles" asp-route-id="@venta.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
