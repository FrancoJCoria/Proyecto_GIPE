@model ResultadoPaginado<Producto>
@{
    ViewData["Title"] = "Productos";
    var busqueda = (string?)ViewData["Busqueda"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Productos</h1>
    <a asp-action="Crear" class="btn btn-primary">+ Nuevo producto</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6 col-lg-5">
        <input type="text" class="form-control" name="busqueda" value="@busqueda" placeholder="Buscar por nombre" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(busqueda))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Stock</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.HayFilas)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay productos que coincidan con la busqueda.</td>
                    </tr>
                }
                @foreach (var producto in Model.Filas)
                {
                    <tr class="@(producto.Estado ? "" : "table-secondary")">
                        <td>@producto.Nombre</td>
                        <td class="text-end">@Formateos.Dinero(producto.PrecioActual)</td>
                        <td class="text-end @(producto.StockActual <= 0 ? "text-danger fw-bold" : "")">
                            @Formateos.Cantidad(producto.StockActual)
                        </td>
                        <td>
                            @if (producto.Estado)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Detalles" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                            <a asp-action="Editar" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (producto.Estado)
                            {
                                <form asp-action="DarDeBaja" asp-route-id="@producto.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Dar de baja el producto @producto.Nombre?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Dar de baja</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Activar" asp-route-id="@producto.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
