@model ProductoDetalleViewModel
@{
    ViewData["Title"] = $"Producto {Model.Producto.Nombre}";
    var producto = Model.Producto;
    var costoInsumos = Model.CostoTotal - producto.CostoExtra;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Producto: @producto.Nombre</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">&laquo; Volver</a>
</div>

<div class="row g-3">
    <div class="col-lg-5 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title mb-0">@producto.Nombre</h5>
                    @if (producto.Estado)
                    {
                        <span class="badge text-bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactivo</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                {
                    <p class="card-text text-muted small">@producto.Descripcion</p>
                }

                @if (!string.IsNullOrWhiteSpace(producto.UrlProducto))
                {
                    <a href="@producto.UrlProducto" target="_blank" rel="noopener" class="d-inline-block mb-3">
                        <img src="@producto.UrlProducto" alt="Imagen de @producto.Nombre"
                             class="img-thumbnail" style="max-height: 160px; max-width: 100%;" />
                    </a>
                }

                <dl class="row mb-3 small">
                    <dt class="col-6">Costo de insumos</dt>
                    <dd class="col-6 text-end">@Formateos.Dinero(costoInsumos)</dd>
                    <dt class="col-6">Costo extra</dt>
                    <dd class="col-6 text-end">@Formateos.Dinero(producto.CostoExtra)</dd>
                    <dt class="col-6 fw-bold">Costo total</dt>
                    <dd class="col-6 text-end fw-bold">@Formateos.Dinero(Model.CostoTotal)</dd>
                    <dt class="col-6">Margen objetivo</dt>
                    <dd class="col-6 text-end">@Formateos.Cantidad(producto.MargenObjetivo) %</dd>
                    <dt class="col-6">Precio de venta</dt>
                    <dd class="col-6 text-end">@Formateos.Dinero(producto.PrecioActual)</dd>
                    <dt class="col-6">Stock actual</dt>
                    <dd class="col-6 text-end @(producto.StockActual <= 0 ? "text-danger fw-bold" : "")">
                        @Formateos.Cantidad(producto.StockActual)
                    </dd>
                </dl>

                <hr />

                @* Carga manual de stock *@
                <form asp-action="AjustarStock" asp-route-id="@producto.Id" method="post" class="row g-2 align-items-end">
                    <div class="col-7">
                        <label class="form-label small mb-1" for="campo-stock">Stock nuevo (carga manual)</label>
                        <input type="number" name="stock" id="campo-stock" class="form-control form-control-sm"
                               min="0" step="0.01" value="@producto.StockActual.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                    </div>
                    <div class="col-5">
                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">Actualizar stock</button>
                    </div>
                </form>

                <hr />

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Editar" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    @if (producto.Estado)
                    {
                        <form asp-action="DarDeBaja" asp-route-id="@producto.Id" method="post"
                              onsubmit="return confirm('¿Dar de baja el producto @producto.Nombre?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Dar de baja</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activar" asp-route-id="@producto.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7 mb-3">
        <partial name="_Receta" model="Model" />
    </div>
</div>
