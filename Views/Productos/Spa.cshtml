@{
    ViewData["Title"] = "Productos (Vue)";
    var esDueno = User.IsInRole("Dueno");
}

<div id="app" data-es-dueno="@esDueno.ToString().ToLower()">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Productos (ABM con Vue)</h1>
        <button v-if="esDueno" class="btn btn-primary" @@click="nuevo">+ Nuevo producto</button>
    </div>

    <div v-if="error" class="alert alert-danger">{{ error }}</div>

    <!-- Buscador: cada tecla pide al servidor la pagina 1 con ese texto -->
    <input v-model="busqueda" @@input="buscar" class="form-control mb-3" placeholder="Buscar por nombre..." />

    <!-- Formulario de alta / edicion -->
    <form v-if="form" @@submit.prevent="guardar" class="card card-body mb-3">
        <h5>{{ form.id ? 'Editar producto' : 'Nuevo producto' }}</h5>
        <div class="row g-2">
            <div class="col-md-6"><label class="form-label">Nombre</label><input v-model="form.nombre" class="form-control" required maxlength="150" /></div>
            <div class="col-md-6"><label class="form-label">Descripción</label><input v-model="form.descripcion" class="form-control" maxlength="500" /></div>
            <div class="col-md-3"><label class="form-label">Costo extra</label><input v-model.number="form.costoExtra" type="number" min="0" step="0.01" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Margen objetivo %</label><input v-model.number="form.margenObjetivo" type="number" min="0" max="100" step="0.01" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Precio</label><input v-model.number="form.precioActual" type="number" min="0" step="0.01" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Stock</label><input v-model.number="form.stockActual" type="number" min="0" step="0.01" class="form-control" /></div>
        </div>
        <div class="mt-3">
            <button class="btn btn-success me-2">Guardar</button>
            <button type="button" class="btn btn-secondary" @@click="form = null">Cancelar</button>
        </div>
    </form>

    <!-- Listado: solo llega la pagina actual -->
    <table class="table table-striped align-middle">
        <thead><tr><th>Nombre</th><th>Precio</th><th>Stock</th><th>Estado</th><th v-if="esDueno"></th></tr></thead>
        <tbody>
            <tr v-for="p in productos" :key="p.id">
                <td>{{ p.nombre }}</td>
                <td>{{ p.precioActual }}</td>
                <td>{{ p.stockActual }}</td>
                <td><span :class="p.estado ? 'badge bg-success' : 'badge bg-secondary'">{{ p.estado ? 'Activo' : 'Baja' }}</span></td>
                <td v-if="esDueno" class="text-end">
                    <button class="btn btn-sm btn-outline-primary me-1" @@click="editar(p)">Editar</button>
                    <button v-if="p.estado" class="btn btn-sm btn-outline-danger" @@click="baja(p)">Dar de baja</button>
                </td>
            </tr>
            <tr v-if="productos.length === 0"><td colspan="5" class="text-center text-muted">Sin resultados</td></tr>
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">Página {{ pagina }} de {{ totalPaginas }} ({{ total }} productos)</span>
        <div>
            <button class="btn btn-outline-secondary btn-sm me-1" :disabled="pagina <= 1" @@click="irAPagina(pagina - 1)">Anterior</button>
            <button class="btn btn-outline-secondary btn-sm" :disabled="pagina >= totalPaginas" @@click="irAPagina(pagina + 1)">Siguiente</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3.4.38/dist/vue.global.prod.js"></script>
    <script src="~/js/productos-vue.js" asp-append-version="true"></script>
}
