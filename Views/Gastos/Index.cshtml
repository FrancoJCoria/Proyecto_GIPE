@model GastosIndexViewModel
@{
    ViewData["Title"] = "Gastos";
    var filtros = Model.Filtros;
    var hayFiltros = filtros.Desde.HasValue || filtros.Hasta.HasValue || filtros.Categoria.HasValue;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Gastos</h1>
    <a asp-action="Crear" class="btn btn-primary">+ Registrar gasto</a>
</div>

@* Filtros por fecha y categoria *@
<form method="get" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label asp-for="Filtros.Desde" class="form-label small mb-1">Desde</label>
                <input asp-for="Filtros.Desde" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filtros.Hasta" class="form-label small mb-1">Hasta</label>
                <input asp-for="Filtros.Hasta" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filtros.Categoria" class="form-label small mb-1">Categoria</label>
                <select asp-for="Filtros.Categoria" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var valor in Enum.GetValues<CategoriaGasto>())
                    {
                        <option value="@valor" selected="@(Model.Filtros.Categoria == valor)">@valor</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-outline-primary">Filtrar</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger small mt-2"></div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Descripcion</th>
                    <th>Categoria</th>
                    <th>Registrado por</th>
                    <th class="text-end">Monto</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Resultado.HayFilas)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            @(hayFiltros ? "No hay gastos que coincidan con los filtros." : "Todavia no hay gastos registrados.")
                        </td>
                    </tr>
                }
                @foreach (var gasto in Model.Resultado.Filas)
                {
                    <tr>
                        <td>@Formateos.Fecha(gasto.Fecha)</td>
                        <td>@gasto.Descripcion</td>
                        <td><span class="badge text-bg-light border">@gasto.Categoria</span></td>
                        <td>@gasto.UsuarioNombre</td>
                        <td class="text-end">@Formateos.Dinero(gasto.Monto)</td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="@gasto.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@gasto.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar el gasto \'@gasto.Descripcion\'? Esta accion no se puede deshacer.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
