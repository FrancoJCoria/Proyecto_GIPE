@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-4">
    <h1 class="display-5">Bienvenido, @User.Identity?.Name</h1>
    <p class="lead">Sistema de gestión GIPE</p>
    <p>
        Rol:
        <span class="badge bg-primary">
            @(User.IsInRole("Dueno") ? "Dueño" : "Empleado")
        </span>
    </p>

    <div class="mt-4">
        <a asp-controller="Account" asp-action="Perfil" class="btn btn-outline-primary">Mi perfil</a>
        @if (User.IsInRole("Dueno"))
        {
            <a asp-controller="Usuarios" asp-action="Index" class="btn btn-primary">Administrar usuarios</a>
        }
    </div>
</div>
